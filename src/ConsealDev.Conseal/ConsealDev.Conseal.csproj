<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>ConsealDev.Conseal</PackageId>
        <!-- A placeholder: publish.yml packs with the version of the tag. -->
        <Version>0.0.0</Version>
        <Authors>consealdev</Authors>
        <Description>Encrypted sync backend for ASP.NET Core: the sync and circle routes of the Conseal Sync contract, over storage that only ever holds ciphertext. Pair with @consealdev/conseal/sync on the client.</Description>
        <PackageTags>conseal;encryption;end-to-end;sync;aspnetcore;dynamodb</PackageTags>
        <PackageProjectUrl>https://conseal.dev</PackageProjectUrl>
        <RepositoryUrl>https://github.com/consealdev/conseal-dotnet</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
        <!-- PackageLicenseExpression can name only the AGPL, so the commercial license goes beside it -->
        <None Include="../../COMMERCIAL-LICENSE.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.513.3" />
        <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ConsealDev.Conseal.Tests" />
    </ItemGroup>

</Project>
